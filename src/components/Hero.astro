---
import { site } from '../config/site'
import Annotation from './Annotation.astro'
import MarkerNote from './MarkerNote.astro'
import Icon from './Icon.astro'
import WeatherBox from './WeatherBox.astro'
---

<section
  aria-labelledby="hero-title"
  class="relative mx-auto max-w-6xl px-6 pt-10 pb-24 md:px-10 md:pt-12 md:pb-36"
>
  <!-- Below lg the weather box sits in flow beside the prompt line; from lg it floats top-right beside the heading. -->
  <div class="flex items-end justify-between gap-4">
    <p
      class="rise font-mono text-[13px] tracking-[0.04em] text-muted"
      style="--i: 0"
    >
      <span class="text-accent-text">~/portfolio</span> <span aria-hidden="true">$</span> whoami<span class="cursor-blink ml-1 inline-block h-[1.05em] w-[0.55em] translate-y-[0.2em] bg-accent" aria-hidden="true"></span>
    </p>
    <WeatherBox class="lg:absolute lg:top-12 lg:right-10" />
  </div>

  <h1
    id="hero-title"
    class="mt-6 text-[clamp(4.25rem,min(23vw,20svh),12rem)] font-[800] leading-[0.82] tracking-[-0.055em]"
  >
    <span class="rise block" style="--i: 1">{site.firstName}</span>
    <span class="rise block pl-[0.55em] md:pl-[1.1em]" style="--i: 2">
      <span class="accent-serif text-[1.12em] tracking-[-0.03em]">{site.lastName}<span class="text-accent">.</span></span>
    </span>
  </h1>

  <div class="mt-10 grid gap-10 md:mt-12 lg:grid-cols-12 lg:gap-8">
    <p
      class="rise text-[clamp(1.35rem,2.6vw,2rem)] font-[500] leading-[1.2] tracking-[-0.02em] md:max-w-2xl lg:col-span-7"
      style="--i: 3"
    >
      Developer building at the intersection of{' '}
      <span class="relative inline-block whitespace-nowrap">
        <span class="relative z-10">AI</span>
        <Annotation shape="circle" class="absolute -top-1.5 -left-1.5 h-[calc(100%+0.75rem)] w-[calc(100%+0.75rem)]" delay={900} />
      </span>{' '}
      and the{' '}
      <span class="relative inline-block whitespace-nowrap">
        web.
        <Annotation shape="underline" class="absolute -bottom-2 left-0 h-3 w-full" delay={1300} />
      </span>
    </p>

    <dl
      class="rise grid gap-4 self-end font-mono text-[13px] md:max-w-md lg:col-span-4 lg:col-start-9"
      style="--i: 4"
    >
      <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-t border-line pt-3">
        <dt class="uppercase tracking-[0.14em] text-muted">Open to</dt>
        <dd>
          <ul>
            {site.roles.map((role) => <li>{role}</li>)}
          </ul>
        </dd>
      </div>
      <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-t border-line pt-3">
        <dt class="uppercase tracking-[0.14em] text-muted">Currently</dt>
        <dd class="flex items-center gap-2">
          <span class="inline-block size-2 rounded-full bg-accent" aria-hidden="true"></span>
          {site.status}
        </dd>
      </div>
    </dl>
  </div>

  <div class="rise relative mt-12 md:mt-12" style="--i: 5">
    <a
      href="#focus"
      class="group inline-flex items-center gap-3 rounded-full bg-accent py-3.5 pr-5 pl-6 font-mono text-[13px] font-medium uppercase tracking-[0.14em] text-canvas transition-[background-color,transform] duration-300 hover:-translate-y-0.5 hover:bg-fg"
    >
      See what I'm into
      <Icon name="arrow-down" class="size-4 transition-transform duration-300 group-hover:translate-y-0.5" />
    </a>
    <div class="pointer-events-none absolute top-1/2 left-[calc(100%-1rem)] hidden -translate-y-[85%] items-end gap-1 sm:left-[17.5rem] sm:flex">
      <Annotation shape="arrow-left" class="h-14 w-20" delay={1700} />
      <MarkerNote class="mb-12 text-3xl" delay={1700} rotate={-6}>start here</MarkerNote>
    </div>
  </div>
</section>
