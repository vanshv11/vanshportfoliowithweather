---
// Top navigation. Desktop: inline links. Mobile: a native <dialog> menu
// (focus trapping and Escape-to-close come from the platform).
import { site } from '../config/site'
---

<header class="sticky top-0 z-30 bg-canvas/85 backdrop-blur-[6px] supports-[not(backdrop-filter:blur(1px))]:bg-canvas">
  <nav
    aria-label="Primary"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 md:h-20 md:px-10"
  >
    <a
      href="#top"
      class="group flex items-center gap-2 font-[800] tracking-[-0.04em] text-xl"
      aria-label={`${site.name} — back to top`}
    >
      <span
        class="grid size-9 place-items-center rounded-full bg-fg text-canvas text-sm transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:-rotate-12"
        >{site.monogram}</span
      >
      <span class="hidden sm:inline">{site.firstName}<span class="text-accent">.</span></span>
    </a>

    <div class="flex items-center gap-4 md:gap-8">
      <ul class="hidden items-center gap-8 md:flex">
        {
          site.nav.map((item, i) => (
            <li>
              <a href={item.href} class="ink-link group font-mono text-[13px] uppercase tracking-[0.14em]">
                <span class="text-muted transition-colors group-hover:text-accent-text">0{i + 1}</span>{' '}
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        class="font-mono text-[13px] uppercase tracking-[0.14em] md:hidden flex items-center gap-2 py-2"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        Menu
        <span aria-hidden="true" class="flex flex-col gap-[5px]">
          <span class="block h-[1.5px] w-5 bg-fg"></span>
          <span class="block h-[1.5px] w-3.5 self-end bg-fg"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<dialog
  id="mobile-menu"
  aria-label="Menu"
  class="m-0 h-dvh max-h-none w-screen max-w-none bg-canvas p-0 text-fg backdrop:bg-transparent open:flex open:flex-col"
>
  <div class="flex h-16 items-center justify-between px-6">
    <span class="grid size-9 place-items-center rounded-full bg-fg text-sm font-[800] tracking-[-0.04em] text-canvas" aria-hidden="true">
      {site.monogram}
    </span>
    <button
      type="button"
      class="font-mono text-[13px] uppercase tracking-[0.14em] py-2"
      data-menu-close
      autofocus
    >
      Close
    </button>
  </div>
  <ul class="flex flex-1 flex-col justify-center gap-2 px-6">
    {
      site.nav.map((item, i) => (
        <li class="border-t border-fg/12">
          <a
            href={item.href}
            class="flex items-baseline gap-4 py-4 text-5xl font-[750] tracking-[-0.035em]"
            data-menu-link
          >
            <span class="font-mono text-sm font-normal tracking-normal text-accent-text">0{i + 1}</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="px-6 pb-8 font-marker text-2xl text-accent-text -rotate-2">thanks for stopping by ✶</p>
</dialog>

<script>
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]')

  opener?.addEventListener('click', () => dialog?.showModal())
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog?.close())
  document.querySelectorAll('[data-menu-link]').forEach((link) =>
    link.addEventListener('click', () => dialog?.close()),
  )
  // Close if the viewport grows past the mobile breakpoint while open.
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) dialog?.close()
  })
  dialog?.addEventListener('close', () => opener?.focus({ preventScroll: true }))
</script>
