---
// Projects styled as a table of contents. While `site.projects` is empty,
// shows a single "in progress" row.
import { site } from '../config/site'
import SectionHeading from './SectionHeading.astro'
import MarkerNote from './MarkerNote.astro'
import Annotation from './Annotation.astro'
import Icon from './Icon.astro'

const projects = site.projects
---

<section aria-labelledby="work" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 md:px-10 md:py-28">
  <SectionHeading id="work" index="03" title="Selected work" accent="work" />

  {
    projects.length === 0 ? (
      <div class="relative">
        <ol class="border-y border-fg/15">
          <li class="flex items-baseline gap-4 py-7 md:gap-6 md:py-9">
            <span class="font-mono text-sm text-accent-text">01</span>
            <span class="text-[clamp(1.4rem,3.2vw,2.5rem)] font-[700] leading-tight tracking-[-0.03em]">
              First case study{' '}<span class="accent-serif text-[1.1em]">in progress</span>
            </span>
            <span class="leader hidden sm:block" aria-hidden="true" />
            <span class="ml-auto font-mono text-xs uppercase tracking-[0.14em] text-muted sm:ml-0">soon</span>
          </li>
          <li class="flex items-baseline gap-4 py-5 text-muted/70 md:gap-6" aria-hidden="true">
            <span class="font-mono text-sm">02</span>
            <span class="h-3 w-40 rounded-full bg-line/70 sm:w-64" />
            <span class="leader hidden sm:block" />
            <span class="font-mono text-xs uppercase tracking-[0.14em]">—</span>
          </li>
          <li class="flex items-baseline gap-4 border-t border-fg/10 py-5 text-muted/70 md:gap-6" aria-hidden="true">
            <span class="font-mono text-sm">03</span>
            <span class="h-3 w-28 rounded-full bg-line/70 sm:w-48" />
            <span class="leader hidden sm:block" />
            <span class="font-mono text-xs uppercase tracking-[0.14em]">—</span>
          </li>
        </ol>
        <div class="pointer-events-none mt-6 flex items-start gap-2 md:absolute md:-top-24 md:right-6 md:mt-0">
          <Annotation shape="arrow" class="hidden h-16 w-16 md:block md:order-2 md:mt-8" delay={200} />
          <MarkerNote class="text-3xl" delay={200} rotate={-5}>cooking — check back soon</MarkerNote>
        </div>
      </div>
    ) : (
      <ol class="border-b border-fg/15">
        {projects.map((project, i) => (
          <li class="group border-t border-fg/15 py-8 md:py-10">
            <div class="flex items-baseline gap-4 md:gap-6">
              <span class="font-mono text-sm text-muted group-hover:text-accent-text">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="text-[clamp(1.4rem,3.2vw,2.5rem)] font-[700] leading-tight tracking-[-0.03em]">
                {project.name}
              </h3>
              <span class="leader hidden sm:block" aria-hidden="true" />
              <span class="hidden font-mono text-xs uppercase tracking-[0.14em] text-muted sm:inline">
                {project.stack.join(' / ')}
              </span>
            </div>
            <p class="mt-3 max-w-2xl pl-10 text-lg leading-snug text-fg/85 md:pl-12">{project.summary}</p>
            <p class="mt-3 flex gap-6 pl-10 font-mono text-[13px] uppercase tracking-[0.14em] md:pl-12">
              {project.github && (
                <a class="ink-link inline-flex items-center gap-1" href={project.github} target="_blank" rel="noopener noreferrer">
                  Code <Icon name="arrow-up-right" class="size-3.5" />
                </a>
              )}
              {project.live && (
                <a class="ink-link inline-flex items-center gap-1" href={project.live} target="_blank" rel="noopener noreferrer">
                  Live <Icon name="arrow-up-right" class="size-3.5" />
                </a>
              )}
            </p>
          </li>
        ))}
      </ol>
    )
  }
</section>
