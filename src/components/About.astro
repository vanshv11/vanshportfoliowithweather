---
import { site } from '../config/site'
import SectionHeading from './SectionHeading.astro'

const isPlaceholder = (text: string) => text.startsWith('[')
---

<section aria-labelledby="about" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 md:px-10 md:py-28">
  <SectionHeading id="about" index="01" title="A little about me" accent="about" />
  <div class="grid gap-8 md:grid-cols-12">
    <p class="font-mono text-xs uppercase leading-relaxed tracking-[0.18em] text-muted md:col-span-3">
      Hello from<br />{site.name}
    </p>
    <div class="space-y-6 text-[clamp(1.15rem,2vw,1.5rem)] leading-[1.45] tracking-[-0.01em] md:col-span-8 md:col-start-5">
      {
        site.about.map((para) =>
          isPlaceholder(para) ? (
            <p class="rounded-sm border border-dashed border-fg/25 px-4 py-3 text-muted">
              <span class="mr-2 font-mono text-[11px] uppercase tracking-[0.14em] text-accent-text">Placeholder</span>
              {para}
            </p>
          ) : (
            <p>{para}</p>
          ),
        )
      }
    </div>
  </div>
</section>
