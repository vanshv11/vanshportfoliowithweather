---
import { site } from '../config/site'
import SectionHeading from './SectionHeading.astro'
import SocialButton from './SocialButton.astro'
import Annotation from './Annotation.astro'
---

<section aria-labelledby="contact" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20 md:px-10 md:py-28">
  <SectionHeading id="contact" index="04" title="Get in touch" accent="touch" />

  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <p class="text-[clamp(3rem,8vw,6.5rem)] font-[800] leading-[0.88] tracking-[-0.05em]">
        Say{' '}
        <span class="relative inline-block">
          <span class="accent-serif text-[1.1em]">hello<span class="text-accent">.</span></span>
          <Annotation shape="underline" class="absolute -bottom-1 left-0 h-4 w-[calc(100%-0.4em)]" delay={300} />
        </span>
      </p>
      <p class="mt-8 max-w-sm text-lg leading-snug text-fg/80">
        Building something interesting, hiring, or just want to talk shop? Find me on any of these.
      </p>
    </div>

    <ul class="border-b border-fg/15 lg:col-span-6 lg:self-end">
      {
        site.socials.map((social) => (
          <li>
            <SocialButton social={social} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
